# 生产环境变量配置
# 此文件用于生产环境部署（GitHub Pages + Railway）

# 后端API地址 - 修改为你的Railway URL
# 获取方式：部署到Railway后，在Railway项目中复制你的public URL
# 格式: https://your-app-name-production-xxx.railway.app/api
VITE_API_BASE_URL=https://your-app-backend.railway.app/api

# 备用API配置（如果需要）
VITE_API_URL=https://your-app-backend.railway.app/api
